LOKI_DATA_PATH=/volumes/containers/observability/loki
PROMTAIL_POSITIONS_PATH=/volumes/containers/observability/promtail/positions.yaml
PROMTAIL_ENVIRONMENT=homelab
PROMTAIL_HOSTNAME=

GRAFANA_DATA_PATH=/volumes/containers/observability/grafana
