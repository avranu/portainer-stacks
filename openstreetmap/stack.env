# Overpass API - openstreetmap stack
#
# Running via `docker compose` directly (not Portainer): copy this file to
# `.env` in this directory so it is auto-loaded, or pass --env-file stack.env.

# init  = build DB from OVERPASS_PLANET_URL (recommended for a regional extract)
# clone = pull a prebuilt full-planet DB (very large, needs OVERPASS_CLONE_SOURCE)
OVERPASS_MODE=clone

# Prebuilt full-planet DB to clone. Default uses minute diffs, meta=no (no attic).
OVERPASS_CLONE_SOURCE=https://dev.overpass-api.de/api_drolbr/
# PLANET_URL is init-mode only; ignored when cloning.
OVERPASS_PLANET_URL=
# Updates for a full-planet clone come from OSM global minute replication.
# Leave blank if you want a static snapshot with no ongoing updates.
OVERPASS_DIFF_URL=https://planet.openstreetmap.org/replication/minute/

OVERPASS_META=no
OVERPASS_COMPRESSION=gz
OVERPASS_UPDATE_SLEEP=3600
OVERPASS_RULES_LOAD=10
OVERPASS_FASTCGI_PROCESSES=4
OVERPASS_MAX_TIMEOUT=1000

# Host path where the Overpass DB lives (mounted at /db in the container).
# IMPORTANT: the ${APP_DIR}/db dir itself must be owned by uid/gid 1000 (the
# image's "overpass" user), e.g. `chown 1000:1000 <APP_DIR>/db`. The entrypoint
# runs `chown -R overpass:overpass /db/*`, which fixes the CONTENTS but never
# /db itself - so if the dir is owned by anyone else the hourly updater fails
# with "cp: cannot create '/db/replicate_id.backup': Permission denied" and the
# database silently stops updating while still answering queries.
APP_DIR=/volumes/containers/openstreetmap/overpass/

# Exposed on ${APP_PORT_PREFIX}80 -> e.g. 31080. API: http://host:31080/api/interpreter
APP_PORT_PREFIX=310

# Resource limits
CPU_LIMIT=4
MEM_LIMIT=16g
